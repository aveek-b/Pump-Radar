            "type": "boolean",
            "title": "Mock"
          },
          "model_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Version"
          },
          "notice": {
            "type": "string",
            "title": "Notice"
          },
          "as_of": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          },
          "markets": {
            "items": {
              "$ref": "#/components/schemas/Market"
            },
            "type": "array",
            "title": "Markets"
          }
        },
        "type": "object",
        "required": [
          "scorer",
          "mock",
          "notice",
          "as_of",
          "markets"
        ],
        "title": "MarketsResponse"
      },
      "RadarResponse": {
        "properties": {
          "scorer": {
